rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Rider avatar photos. One overwritable file per user — no growing
    // history, trivial to remove on account deletion. Readable by any
    // signed-in rider (matches the app's existing auth-gated social model,
    // e.g. rider_tags in firestore.rules), writable only by the owner, with
    // server-side size/type checks behind the client-side compression done
    // at pick time (image_picker maxWidth/maxHeight/imageQuality).
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
