rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }


    // Private user profile documents (Owner read/write only, PII protected)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false; // Deletion handled securely by Cloud Functions

      // Owner-scoped sync subcollections (used by ApexSyncCoordinator's
      // users/{uid}/{entityType}/{entityId} remote-sync model).
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Garage motorcycles (Owner read/write only, via userId field)
    match /bikes/{bikeId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Ride sessions (Owner read/write only, via userId field)
    match /rides/{rideId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Friendships (Either participant may read/manage the link, via userA/userB fields)
    match /friendships/{friendshipId} {
      allow read, delete: if signedIn() && (
        resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid
      );
      allow create: if signedIn() && (
        request.resource.data.userA == request.auth.uid || request.resource.data.userB == request.auth.uid
      );
    }

    // Group ride lobbies (Join-by-code product model; hostId/riders are app-level
    // rider tags, not Firebase UIDs, so per-member Firestore-native ACLs aren't
    // possible without a schema change. Signed-in access only, scoped decision
    // 2026-08-04 — see memory-bank/progress.md.)
    match /lobbies/{lobbyId} {
      allow read, write: if signedIn();
    }

    // Smart Park QR contact notes (written anonymously by qr_contact_web with no
    // auth — a scanner has no ApexFlow account. Read/update restricted to the
    // vehicle's registered owner via the rider_tags ownership lookup.)
    match /parking_notifications/{noteId} {
      allow create: if request.resource.data.vehicleId is string
        && request.resource.data.read == false;
      allow read, update: if signedIn()
        && get(/databases/$(database)/documents/rider_tags/$(resource.data.vehicleId)).data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // Public Rider Cards (Public read, Backend write only)
    match /public_rider_cards/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Rider Tag lookup registry (Public read, Owner manage permitted)
    match /rider_tags/{tag} {
      allow read: if true;
      allow write: if signedIn() && (
        resource == null
        || resource.data.ownerId == request.auth.uid
      ) && request.resource.data.ownerId == request.auth.uid;
    }

    // Entitlements & Premium subscriptions (Owner read only, Backend/Store webhook write only)
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Private notification FCM tokens (Owner create/update/delete only, Read false)
    match /notification_tokens/{uid}/devices/{deviceId} {
      allow read: if false;
      allow create, update, delete: if isOwner(uid);
    }

    // Smart Park Relay (Callable Functions only)
    match /parking_requests/{requestId} {
      allow read, write: if false;
    }

    // Bug Reports & Madeforth QA Engine (Callable Functions create/update, Reporter read only)
    match /bug_reports/{bugId} {
      allow create, update, delete: if false;
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      match /events/{eventId} {
        allow write: if false;
        allow read: if signedIn()
                    && get(/databases/$(database)/documents/bug_reports/$(bugId)).data.reporterUid == request.auth.uid
                    && resource.data.publicMessage != null;
      }
    }
    match /bug_dispatch_outbox/{document=**} {
      allow read, write: if false;
    }
    match /bug_report_idempotency/{document=**} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
